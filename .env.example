# ---------------------------------------------------------------------------
# AIDD — env template. Onboard: cp .env.example .env.local  (rồi điền giá trị)
# .env.local bị gitignore (chứa secret). File .example này là placeholder, an toàn commit.
# Next.js nạp .env.local tự động; scripts seed dùng: node --env-file=.env.local
# ---------------------------------------------------------------------------

# --- Supabase (local dev) — lấy từ `supabase status` sau khi `supabase start` ---
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_ANON_KEY=<local-anon-key-tu-supabase-status>
SUPABASE_SERVICE_ROLE_KEY=<local-service-role-key-tu-supabase-status>   # server-only, KHÔNG prefix NEXT_PUBLIC
SUPABASE_DB_URL=postgresql://postgres:postgres@127.0.0.1:54322/postgres

# --- Event ---
EVENT_START_AT=2026-09-01T00:00:00+07:00   # countdown target (nếu dùng qua env; nguồn chính là bảng event_config)

# --- Google OAuth (đăng nhập) ---
GOOGLE_CLIENT_ID=<google-oauth-client-id>
GOOGLE_CLIENT_SECRET=<google-oauth-client-secret>

# --- Feature flags ---
NEXT_PUBLIC_ENABLE_DEV_LOGIN=true   # bật màn /dev-login cho local; production để false

# ---------------------------------------------------------------------------
# LƯU Ý: MOMORPH_GITHUB_TOKEN KHÔNG đặt ở đây.
# Nó là shell env cho MCP (.mcp.json đọc ${MOMORPH_GITHUB_TOKEN}), không phải Next.js runtime.
# Export trong ~/.zshrc hoặc trước khi mở Claude Code.
# ---------------------------------------------------------------------------
