#!/usr/bin/env bash
# pre-push hook — Docs anti-drift warning (WARN-ONLY, never blocks).
#
# Flags possible docs drift: when a push contains changes under src/ but none under docs/.
# Reads ref pairs from stdin per the git pre-push protocol, so it is robust for the
# first push of a branch (remote sha is all-zeros → diff against the empty tree).
#
# Escape once:  SKIP_DOCS_CHECK=1 git push ...
[ "${SKIP_DOCS_CHECK:-}" = "1" ] && exit 0

zero="0000000000000000000000000000000000000000"
empty_tree="4b825dc642cb6eb9a060e54bf8d69288fbee4904"   # git's canonical empty-tree object
warned=0

while read -r local_ref local_sha remote_ref remote_sha; do
  [ "$local_sha" = "$zero" ] && continue          # branch deletion — nothing to inspect
  if [ "$remote_sha" = "$zero" ]; then
    range="$empty_tree..$local_sha"               # first push — diff whole branch history
  else
    range="$remote_sha..$local_sha"
  fi

  changed="$(git diff --name-only "$range" 2>/dev/null)"
  [ -z "$changed" ] && continue

  if printf '%s\n' "$changed" | grep -q '^src/' && ! printf '%s\n' "$changed" | grep -q '^docs/'; then
    warned=1
  fi
done

if [ "$warned" = "1" ]; then
  {
    echo ""
    echo "⚠  pre-push: src/ changed but docs/ unchanged in this push — docs may be drifting."
    echo "   Run:  npm run docs:sync   (then commit any docs/ updates)"
    echo "   Skip once with:  SKIP_DOCS_CHECK=1 git push ..."
    echo ""
  } >&2
fi

# --- Weekly rebuild-spec staleness nudge (WARN-ONLY) ---------------------------
# docs:sync only link-checks; full source-regeneration needs an agent
# (/tkm:rebuild-spec). Nudge when src/ has moved on but docs/ have not been
# regenerated for over a week — i.e. the newest src/ commit is >7 days newer
# than the newest docs/ commit. Uses git history only — no marker file, no
# manual upkeep. Escape once:  SKIP_REBUILD_NUDGE=1 git push ...
if [ "${SKIP_REBUILD_NUDGE:-}" != "1" ]; then
  docs_ct="$(git log -1 --format=%ct -- docs/ 2>/dev/null)"
  src_ct="$(git log -1 --format=%ct -- src/ 2>/dev/null)"
  week=604800
  if [ -n "$docs_ct" ] && [ -n "$src_ct" ] && [ "$src_ct" -gt "$docs_ct" ] \
     && [ "$((src_ct - docs_ct))" -gt "$week" ]; then
    days="$(( (src_ct - docs_ct) / 86400 ))"
    {
      echo ""
      echo "⚠  pre-push: docs/ not regenerated in ${days}d while src/ kept moving."
      echo "   Docs are source-generated — link-check alone won't catch drift."
      echo "   Run:  /tkm:rebuild-spec   (then review + commit docs/ changes)"
      echo "   Skip once with:  SKIP_REBUILD_NUDGE=1 git push ..."
      echo ""
    } >&2
  fi
fi

exit 0   # warn-only — the push always proceeds
