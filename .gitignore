# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
# ...nhưng vẫn commit template onboarding (glob .env* nuốt cả .example nên phải mở ngoại lệ)
!.env.example

# MCP local config — có thể chứa token thật. Copy từ .mcp.example.json (committed).
.mcp.json

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# Takumi Agent Kit — reinstall via `tkm init` (như node_modules). Chỉ commit rules dự án + shared config.
.claude/*
!.claude/rules/
!.claude/settings.json
# Project-specific workflow assets (commit these — teammates need them on clone):
!.claude/roles/
!.claude/skills/
.claude/skills/*
# Skill project tự build: đặt tên `aidd-<name>` → tự động được push. Kit skills (khác prefix) vẫn ignore.
!.claude/skills/aidd-*/
# Legacy: check-progress commit trước khi có convention aidd-*; giữ nguyên để khỏi churn.
!.claude/skills/check-progress/
# Template project-specific: chỉ push clarifications.md; template của kit (bug-fix/refactor/feature/stacks) vẫn ignore.
!.claude/templates/
.claude/templates/*
!.claude/templates/plans/
.claude/templates/plans/*
!.claude/templates/plans/clarifications.md

# Supabase local temp
supabase/.branches
supabase/.temp

# Playwright test artifacts
playwright-report/
test-results/
.playwright-mcp/
