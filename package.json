{
  "name": "aidd",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "next dev -p 3001",
    "dev2": "next dev -p 3002",
    "build": "next build",
    "analyze": "ANALYZE=true next build --webpack",
    "start": "next start",
    "lint": "eslint",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "test:e2e": "playwright test",
    "hooks:install": "git config core.hooksPath .githooks",
    "prepare": "git config core.hooksPath .githooks || true",
    "docs:sync": "node .claude/scripts/validate-docs.cjs docs --src src && printf '\\n%s\\n' 'Docs link/ref check done. Full regeneration needs an agent: run /tkm:rebuild-spec, then commit docs/ changes.'",
    "seed:auth": "node --env-file=.env.local supabase/seed-auth-users.mjs",
    "seed:demo": "psql postgresql://postgres:postgres@127.0.0.1:54322/postgres -X -f supabase/seed-demo-data.sql",
    "db:reset": "supabase db reset && npm run seed:auth && npm run seed:demo",
    "event:pre": "psql postgresql://postgres:postgres@127.0.0.1:54322/postgres -X -c \"UPDATE event_config SET event_start_at = now() + interval '10 minutes' WHERE id=1 RETURNING event_start_at;\"",
    "event:soon": "psql postgresql://postgres:postgres@127.0.0.1:54322/postgres -X -c \"UPDATE event_config SET event_start_at = now() + interval '20 seconds' WHERE id=1 RETURNING event_start_at;\"",
    "event:live": "psql postgresql://postgres:postgres@127.0.0.1:54322/postgres -X -c \"UPDATE event_config SET event_start_at = now() - interval '1 day' WHERE id=1 RETURNING event_start_at;\""
  },
  "dependencies": {
    "@supabase/ssr": "^0.12.4",
    "@supabase/supabase-js": "^2.111.0",
    "@tanstack/react-query": "^5.101.4",
    "@tiptap/extension-character-count": "^3.29.2",
    "@tiptap/extension-link": "^3.29.2",
    "@tiptap/extension-mention": "^3.29.2",
    "@tiptap/extension-placeholder": "^3.29.2",
    "@tiptap/pm": "^3.29.2",
    "@tiptap/react": "^3.29.2",
    "@tiptap/starter-kit": "^3.29.2",
    "@tiptap/suggestion": "^3.29.2",
    "@types/sanitize-html": "^2.16.1",
    "lucide-react": "^1.28.0",
    "next": "16.2.12",
    "next-intl": "^4.13.4",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "react-zoom-pan-pinch": "^4.0.4",
    "sanitize-html": "^2.17.5",
    "sonner": "^2.0.7",
    "swiper": "^14.0.7",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@next/bundle-analyzer": "^16.3.0",
    "@playwright/test": "^1.62.0",
    "@tailwindcss/postcss": "^4",
    "@testing-library/jest-dom": "^7.0.0",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.1",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@vitest/coverage-v8": "^4.1.11",
    "eslint": "^9",
    "eslint-config-next": "16.2.12",
    "happy-dom": "^20.11.1",
    "jsdom": "^27.0.1",
    "pixelmatch": "^7.2.0",
    "pngjs": "^7.0.0",
    "tailwindcss": "^4",
    "typescript": "^5",
    "vitest": "^4.1.10"
  }
}
